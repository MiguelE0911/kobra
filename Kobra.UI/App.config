<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Ajuste "Server" a su instancia de SQL Server:
        SQL Express : localhost\SQLEXPRESS
        LocalDB     : (localdb)\MSSQLLocalDB
      La base se crea con Database\01_CrearBaseDatos.sql.
    -->
    <add name="Kobra"
         connectionString="Server=localhost\SQLEXPRESS;Database=Kobra;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
